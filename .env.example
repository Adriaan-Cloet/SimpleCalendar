# Copy to `.env` (untracked) to build with a Google OAuth client; see docs/google-cloud.md.
# Without them the app builds, and Google sign-in asks for the user's own client id.
# After creating or changing `.env`, run `touch src-tauri/build.rs` once.
SIMPLECALENDAR_GOOGLE_CLIENT_ID=
SIMPLECALENDAR_GOOGLE_CLIENT_SECRET=
