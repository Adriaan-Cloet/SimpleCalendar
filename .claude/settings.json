{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "cd \"$CLAUDE_PROJECT_DIR\" && cargo fmt --manifest-path src-tauri/Cargo.toml && npx prettier --write --log-level silent src" }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(cargo test:*)", "Bash(cargo clippy:*)", "Bash(cargo fmt:*)",
      "Bash(npm run:*)", "Bash(gh issue:*)", "Bash(gh pr:*)"
    ]
  }
}